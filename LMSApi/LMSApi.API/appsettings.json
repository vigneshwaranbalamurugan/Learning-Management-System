{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/lms-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "Cloudinary": {
    "CloudName": "YOUR_CLOUD_NAME",
    "ApiKey": "YOUR_API_KEY",
    "ApiSecret": "YOUR_API_SECRET",
    "Folder": "lms/profile-pictures",
    "CourseThumbnailFolder": "lms/course-thumbnails",
    "CourseVideoFolder": "lms/course-videos"
  },
  "FileSizeLimits": {
    "ProfileImageinMB": "5",
    "CourseThumbnailInMB": "5",
    "CourseVideoInMB": "50",
    "AssignmentAttachmentInMB": "5",
    "LessonVideoInMB": "50",
    "LessonPdfInMB": "10"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "Username": "your.email@example.com",
    "Password": "YOUR_APP_PASSWORD",
    "From": "noreply@lms.com"
  },
  "Jwt": {
    "Key": "YOUR_SUPER_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG",
    "Issuer": "LMSApiDev",
    "Audience": "LMSApiUsersDev",
    "ExpiresMinutes": 30,
    "RefreshTokenExpiresDays": 7,
    "SessionRefreshTokenExpiresDays": 1
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=lmsdevdb;Username=postgres;Password=YOUR_POSTGRES_PASSWORD"
  },
  "App": {
    "BaseUrl": "http://localhost:5029",
    "BasePath": "api/v1"
  },
  "Razorpay": {
    "KeyId": "rzp_test_YOUR_KEY_ID",
    "KeySecret": "YOUR_KEY_SECRET",
    "WebhookSecret": "MySuperSecretLmsWebhookPassword2026!"
  },
  "Stripe": {
    "SecretKey": "sk_test_YOUR_SECRET_KEY",
    "PublishableKey": "pk_test_YOUR_PUBLISHABLE_KEY"
  },
  "Redis": {
    "ConnectionString": "127.0.0.1:6379",
    "InstanceName": "lms:"
  },
  "Cache": {
    "CategoriesTtlMinutes": 1440,
    "ProfileTtlMinutes": 15,
    "CourseDetailTtlMinutes": 30,
    "CourseStatsTtlMinutes": 10
  },
    "RateLimiting":{
    "LoginPermitLimit":"5",
    "ForgotPasswordPermitLimit":"3",
    "OtpSendPermitLimit":"3",
    "OtpVerifyPermitLimit":"3",
    "RegisterPermitLimit":"5",
    "PublicCourseListingPermitLimit":"100",
    "SearchCoursesPermitLimit":"60",
    "EnrollCoursePermitLimit":"10",
    "PaymentInitializationPermitLimit":"3",
    "QuizSubmitPermitLimit":"20",
    "AssignmentSubmitPermitLimit":"10",
    "FileUploadPermitLimit":"20",
    "CertificateDownloadPermitLimit":"30",
    "NotificationApisPermitLimit":"60",
    "AdminApisPermitLimit":"200",
    "SignalRHubConnectNotificationPermitLimit":"20",
    "SignalRHubConnectVideoProgressPermitLimit":"20"
  },
  "Security":{
    "SaltSize":"16",
    "KeySize":"32",
    "Iterations":"100000"
  }
}